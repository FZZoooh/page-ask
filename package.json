{
  "name": "pageask",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.22.0",
  "description": "Edge side panel: ask AI about the page you are on",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "compile": "tsc --noEmit && node scripts/check-syntax.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "ext:key": "node scripts/ext-key.mjs",
    "ext:id": "node scripts/ext-id.mjs",
    "test:server": "node scripts/run-server-tests.mjs",
    "verify": "pnpm check:i18n && pnpm compile && pnpm test:server && pnpm build",
    "server": "node server/index.mjs",
    "server:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-server.ps1",
    "postinstall": "wxt prepare",
    "tray": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tray.ps1",
    "tray:bg": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tray-bg.ps1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^7.0.2",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "defuddle": "^0.19.6",
    "fflate": "^0.8.3",
    "katex": "0.16.47",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  }
}
